<?xml version="1.0" encoding="UTF-8"?>
<!-- Vantage has its own package identity, so it installs beside Cinnabar and never upgrades it.
     WiX v5 (Files element). Build via build-installer.ps1, which supplies Version, Payload and Icon. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Vantage" Manufacturer="Vantage" Version="$(Version)"
           UpgradeCode="A3036D81-6368-4CA1-964B-CC43A2335337" Scope="perMachine" Compressed="yes">
    <!-- Signed build ordering and explicit channel-switch consent are enforced by the updater. -->
    <MajorUpgrade Schedule="afterInstallInitialize" AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="cinnabar.ico" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="cinnabar.ico" />
    <!-- The update helper owns the client relaunch. -->
    <Property Id="MSIDISABLERMRESTART" Value="1" />

    <!-- A custom INSTALLFOLDER from the command line is kept, so upgrades stay in place. -->
    <Property Id="INSTALLFOLDER" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Vantage">
        <!-- Layout: the runtime executables beside a resources\ tree. -->
      </Directory>
    </StandardDirectory>

    <!-- Each scope keys its shortcuts separately, so removing one product never breaks the other's. -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopAppShortcut" Name="Vantage" Target="[INSTALLFOLDER]cinnabar.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="cinnabar.ico" />
        <RegistryValue Root="HKCU" Key="Software\Vantage" Name="desktop-shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="AppShortcut" Name="Vantage" Target="[INSTALLFOLDER]cinnabar.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="cinnabar.ico" />
        <RegistryValue Root="HKCU" Key="Software\Vantage" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Vantage" Level="1">
      <Files Directory="INSTALLFOLDER" Include="$(Payload)\**" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>
</Wix>
