<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <!-- The embedded MSI remains the single owner of files, shortcuts and upgrades. -->
  <Bundle Name="Vantage Setup" Manufacturer="Vantage" Version="$(Version)"
          UpgradeCode="04A1D0E5-183B-4555-B58B-93F800D3C830" IconSourceFile="$(Icon)">
    <BootstrapperApplication>
      <!-- The branded theme (see theme/) replaces the stock window; its sidebar is a payload the theme names. -->
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl=""
                                               LogoFile="$(Logo)"
                                               ThemeFile="$(Theme)/vantage-theme.xml"
                                               LocalizationFile="$(Theme)/vantage-theme.wxl" />
      <Payload Name="sidebar.png" SourceFile="$(Theme)/sidebar.png" />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage SourceFile="$(Msi)" Compressed="yes" Visible="no" />
    </Chain>
  </Bundle>
</Wix>
