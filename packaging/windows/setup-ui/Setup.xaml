<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Margin="14" CornerRadius="18" Background="#0E0B26" BorderBrush="#2B2560" BorderThickness="1" SnapsToDevicePixels="True">
  <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="Black"/></Border.Effect>
  <Border.Resources>
    <SolidColorBrush x:Key="Text" Color="#F2F0FF"/>
    <SolidColorBrush x:Key="Muted" Color="#9A95C9"/>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Height" Value="40"/><Setter Property="MinWidth" Value="132"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="10" Padding="22,0">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#6D5EF7" Offset="0"/><GradientStop Color="#3FA9F5" Offset="1"/></LinearGradientBrush></Border.Background>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="#C9C5F0"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="40"/><Setter Property="MinWidth" Value="96"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="10" Padding="20,0" Background="Transparent" BorderBrush="#37307A" BorderThickness="1">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1D1747"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Foreground" Value="#9A95C9"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="b" CornerRadius="8" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2B2560"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Border.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border CornerRadius="18,0,0,18" ClipToBounds="True">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2A1F7A" Offset="0"/><GradientStop Color="#150F45" Offset="0.55"/><GradientStop Color="#0B0820" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid>
        <Ellipse Width="340" Height="340" Margin="0,0,0,40" VerticalAlignment="Center">
          <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#665B5BFF" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
        <StackPanel VerticalAlignment="Center" Margin="0,-10,0,0">
          <Image x:Name="Mark" Width="150" Height="150"/>
          <TextBlock Text="VANTAGE" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0">
            <TextBlock.Foreground><LinearGradientBrush><GradientStop Color="#A9B4FF" Offset="0"/><GradientStop Color="#7DD3FC" Offset="1"/></LinearGradientBrush></TextBlock.Foreground>
          </TextBlock>
          <TextBlock Text="A faster way to play Bedrock" Foreground="#8F8ACB" FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
        <TextBlock x:Name="VersionText" Foreground="#6C67A8" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="40,0,36,30">
      <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Margin="0,0,-24,0" Background="Transparent">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,0,0">
          <Button x:Name="MinBtn" Style="{StaticResource Chrome}" Content="&#x2013;" FontSize="16"/>
          <Button x:Name="CloseBtn" Style="{StaticResource Chrome}" Content="&#x2715;" FontSize="12"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <StackPanel x:Name="PageWelcome" VerticalAlignment="Center">
          <TextBlock Text="Welcome to Vantage" Foreground="{StaticResource Text}" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock Text="A fast, modern Minecraft Bedrock client. Setup takes under a minute." Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,26"/>
          <Border Background="#171240" CornerRadius="12" Padding="16,14" BorderBrush="#2B2560" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="Installs to" Foreground="{StaticResource Muted}" FontSize="12"/>
              <TextBlock x:Name="FolderText" Foreground="{StaticResource Text}" FontSize="14" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
          <Button x:Name="ChangeFolder" Content="Change location" Style="{StaticResource Chrome}" Width="Auto" Height="30" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,0" FontSize="13" Foreground="#7DD3FC"/>
        </StackPanel>
        <StackPanel x:Name="PageMaintain" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="Vantage is installed" Foreground="{StaticResource Text}" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock Text="Repair the installation to restore missing files, or remove Vantage from this PC." Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel x:Name="PageProgress" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock x:Name="ProgressTitle" Text="Installing Vantage" Foreground="{StaticResource Text}" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock x:Name="ProgressStatus" Text="Preparing..." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,10,0,26" TextTrimming="CharacterEllipsis"/>
          <Border Height="10" CornerRadius="5" Background="#1B1548">
            <Grid>
              <Border x:Name="BarFill" HorizontalAlignment="Left" Width="0" CornerRadius="5">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#6D5EF7" Offset="0"/><GradientStop Color="#7DD3FC" Offset="1"/></LinearGradientBrush></Border.Background>
              </Border>
            </Grid>
          </Border>
          <TextBlock x:Name="ProgressPercent" Text="0%" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel x:Name="PageDone" VerticalAlignment="Center" Visibility="Collapsed">
          <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Left" Margin="0,0,0,20">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#6D5EF7" Offset="0"/><GradientStop Color="#3FA9F5" Offset="1"/></LinearGradientBrush></Border.Background>
            <TextBlock Text="&#x2713;" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="DoneTitle" Text="You are all set" Foreground="{StaticResource Text}" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock x:Name="DoneText" Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel x:Name="PageError" VerticalAlignment="Center" Visibility="Collapsed">
          <Border Width="56" Height="56" CornerRadius="28" Background="#E5484D" HorizontalAlignment="Left" Margin="0,0,0,20">
            <TextBlock Text="!" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Something went wrong" Foreground="{StaticResource Text}" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock x:Name="ErrorText" Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="SecondaryBtn" Style="{StaticResource Ghost}" Margin="0,0,12,0"/>
        <Button x:Name="PrimaryBtn" Style="{StaticResource Primary}"/>
      </StackPanel>
    </Grid>
  </Grid>
</Border>
