text\":\"cannot reach the internet.\",\"color\":[0.77,0.72,0.87,1],\"font_scale_factor\":0.7,\"size\":[157,17],\"offset\":[7,308]}},{\"tips0@technic.t0\":{\"controls\":[{\"tip0@technic.t0\":{\"controls\":[{\"s@technic.t1\":{\"radius\":5,\"color\":[0.05,0.038,0.098,0.98],\"size\":[121,26],\"offset\":[0,0],\"bindings\":[{\"binding_name\":\"#row_19_hover\",\"binding_name_override\":\"#alpha\"}],\"shadow_color\":[0,0,0,0.5],\"shadow_blur\":8,\"shadow_offset\":[0,3],\"shadow_spread\":0}},{\"e@technic.t1\":{\"radius\":5,\"color\":[0.43,0.37,0.64,1],\"size\":[121,26],\"offset\":[0,0],\"bindings\":[{\"binding_name\":\"#row_19_hover\",\"binding_name_override\":\"#alpha\"}]}},{\"b@technic.t1\":{\"radius\":4,\"color\":[0.074,0.054,0.139,0.98],\"size\":[119,24],\"offset\":[1,1],\"bindings\":[{\"binding_name\":\"#row_19_hover\",\"binding_name_override\":\"#alpha\"}]}},{\"t@technic.t2\":{\"text\":\"Queues the next game now.\\nClick, then press a key.\",\"color\":[0.96,0.95,0.99,1],\"font_scale_factor\":0.7,\"size\":[111,20],\"offset\":[6,4],\"bindings\":[{\"binding_name\":\"#row_19_hover\",\"binding_name_override\":\"#alpha\"}]}}],\"size\":[121,26],\"offset\":[7,46]}},{\"tip1@technic.t0\":{\"controls\":[{\"s@technic.t1\":{\"radius\":5,\"color\":[0.05,0.038,0.098,0.98],\"size\":[151,26],\"offset\":[0,0],\"bindings\":[{\"binding_name\":\"#row_20_hover\",\"binding_name_override\":\"#alpha\"}],\"shadow_color\":[0,0,0,0.5],\"shadow_blur\":8,\"shadow_offset\":[0,3],\"shadow_spread\":0}},{\"e@technic.t1\":{\"radius\":5,\"color\":[0.43,0.37,0.64,1],\"size\":[151,26],\"offset\":[0,0],\"bindings\":[{\"binding_name\":\"#row_20_hover\",\"binding_name_override\":\"#alpha\"}]}},{\"b@technic.t1\":{\"radius\":4,\"color\":[0.074,0.054,0.139,0.98],\"size\":[149,24],\"offset\":[1,1],\"bindings\":[{\"binding_name\":\"#row_20_hover\",\"binding_name_override\":\"#alpha\"}]}},{\"t@technic.t2\":{\"text\":\"Game OVER, your whole party is\\nout, or you finished the course.\",\"color\":[0.96,0.95,0.99,1],\